{
  "name": "neurogrip",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:conformance": "vitest run packages/core/test/conformance.test.ts",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/design/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "fixtures": "python -m neurogrip.fixtures --out fixtures/conformance/golden.json",
    "build:assets": "node scripts/build-assets.mjs",
    "dev:web": "npm run stage:web && npm run dev --workspace @neurogrip/web -- --host 127.0.0.1",
    "test:e2e": "playwright test",
    "stage:web": "npm run stage:model && npm run stage:cartography && npm run stage:attribution && npm run stage:clinician",
    "stage:model": "node scripts/stage-model.mjs",
    "stage:cartography": "node scripts/stage-cartography.mjs",
    "stage:attribution": "node scripts/stage-attribution.mjs",
    "stage:clinician": "node scripts/stage-clinician.mjs",
    "ttum": "vite-node scripts/ttum.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "typescript": "^5.7.0",
    "vite-node": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
