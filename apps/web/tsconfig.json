{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@neurogrip/core": ["../../packages/core/src/index.ts"],
      "@neurogrip/design": ["../../packages/design/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "e2e/**/*.ts",
    "aliases.ts",
    "vite.config.ts",
    "vitest.unit.config.ts",
    "vitest.dom.config.ts"
  ]
}
